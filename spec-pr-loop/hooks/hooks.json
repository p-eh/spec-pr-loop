{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.py\"",
            "timeout": 10,
            "statusMessage": "git-guard: checking for destructive git"
          }
        ]
      }
    ]
  }
}
